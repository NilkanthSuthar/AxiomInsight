# Copy to .env and fill in. Everything here is optional except OPENAI_API_KEY.

# --- Required for embedding, query routing and answer generation -----------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Optional: enables Cohere reranking of retrieved documents -------------
# Without it, retrieval falls back to plain vector similarity.
# https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# --- Optional: LangSmith tracing -------------------------------------------
# Tracing is off unless LANGCHAIN_TRACING_V2=true AND a key is set.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=axiom-insight

# --- Optional: seed credentials (used by scripts/seed.py) ------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- Optional: model overrides ---------------------------------------------
CLASSIFIER_MODEL=gpt-4o-mini
ANSWER_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# --- Optional: retrieval tuning --------------------------------------------
RETRIEVAL_K=3
RERANK_CANDIDATES=10

# --- Vector store backend ---------------------------------------------------
# "chroma" (default, embedded, no account needed) or "pinecone" (managed).
# Pinecone additionally needs: pip install -r requirements-pinecone.txt
VECTOR_STORE=chroma
CHROMA_COLLECTION=my_collection
# PINECONE_API_KEY=
# PINECONE_INDEX=axiom-insight
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# --- Optional: storage paths (relative to the repository root) -------------
DB_PATH=roles_docs.db
CHROMA_PATH=chroma_db
DUCKDB_PATH=static/data/structured_queries.duckdb
